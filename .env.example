# ═══════════════════════════════════════════════════════════════
#  NexaCRM AI — Environment Configuration Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
APP_NAME=NexaCRM AI
APP_ENV=development           # development | staging | production
APP_PORT_FRONTEND=3000
APP_PORT_BACKEND=8080
SEED_DEMO_USERS=false
SEED_DEMO_USERS_PASSWORD=change-me-before-enabling
SEED_DEMO_USERS_RESET_PASSWORDS=true

# ── Database (MongoDB Atlas) ──────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nexacrm

# ── JWT Security ────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-very-long-random-secret-key-here-minimum-64-chars
JWT_EXPIRATION_MS=86400000        # 24 hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500

# ── Email (SMTP / Gmail) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password   # Use App Password, NOT your real password
EMAIL_FROM_NAME=NexaCRM AI
EMAIL_FROM_ADDRESS=noreply@nexacrm.com

# ── Meta (Facebook & Instagram) ─────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_TOKEN=your-whatsapp-webhook-token
META_PAGE_ACCESS_TOKEN=your-page-access-token

# ── WhatsApp Business Cloud API ──────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_API_VERSION=v19.0
AIADRIKA_BASE_URL=https://aiadrika.in/api/send
AIADRIKA_INSTANCE_ID=your-aiadrika-instance-id
AIADRIKA_ACCESS_TOKEN=your-aiadrika-access-token
AUTO_REPLY_ENABLED=true
AUTO_REPLY_MESSAGE=Thanks for messaging NexaCRM! We received your message and will get back to you shortly.
CALL_AGENT_ENABLED=false
CALL_AGENT_AUTO_ON_LEAD_CREATE=false
CALL_AGENT_WEBHOOK_URL=https://your-calling-agent-webhook.example.com/outbound-call
CALL_AGENT_API_KEY=your-calling-agent-api-key
CALL_AGENT_AGENT_ID=your-calling-agent-id
CALL_AGENT_FROM_NUMBER=+911234567890
CALL_AGENT_TIMEOUT_MS=12000
CALL_AGENT_PROVIDER=bolna
CALL_AGENT_BOLNA_API_URL=https://api.bolna.ai
CALL_AGENT_BOLNA_API_KEY=your-bolna-api-key
CALL_AGENT_BOLNA_AGENT_ID=your-bolna-agent-id
CALL_AGENT_BOLNA_VOICE_ID=
CALL_AGENT_CALLBACK_WEBHOOK_URL=http://localhost:8080/api/calls/webhook

# ── Twilio Integration ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBERS=+12055551234,+12055559876
TWILIO_DEFAULT_FROM_NUMBER=+12055551234

# ── LinkedIn API ─────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/integrations/linkedin/callback

# ── Gmail / Google Calendar ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ── AWS S3 ───────────────────────────────────────────────────────
AWS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_BUCKET=nexacrm-files
AWS_REGION=ap-south-1

# ── Cloudinary (image/avatar storage) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── Tally XML API ────────────────────────────────────────────────
TALLY_HOST=http://localhost
TALLY_PORT=9000

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend Vite ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws
VITE_APP_NAME=NexaCRM AI
VITE_APP_VERSION=1.0.0
